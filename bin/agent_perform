#!/usr/bin/env ruby
# frozen_string_literal: true
require 'optparse'
require_relative '../lib/live2d_studio'
require_relative '../lib/live2d_studio/performance'

$stdout.sync = true
options = {}
OptionParser.new do |parser|
  parser.banner = 'Usage: ruby bin/agent_perform --script performance.json --output video.mp4 [--validate]'
  parser.on('--script PATH', 'JSON voice lines and head-motion cues') { |value| options[:script] = value }
  parser.on('--output PATH', 'New H.264 MP4 output') { |value| options[:output] = value }
  parser.on('--validate', 'Validate the script without contacting the studio') { options[:validate] = true }
  parser.on('-h', '--help') { puts parser; exit }
end.parse!

begin
  raise Live2D::Error, 'Provide --script' unless options[:script]
  script_path = File.expand_path(options[:script])
  plan = Live2D::Performance.new(JSON.parse(File.read(script_path)))
  if options[:validate]
    puts "Valid: #{plan.lines.length} lines, #{plan.provider} voice, #{plan.width}x#{plan.height} at #{plan.fps} FPS"
  else
    raise Live2D::Error, 'Provide --output' unless options[:output]
    require_relative '../lib/live2d_studio/performance_runner'
    Live2D::PerformanceRunner.new(plan, script_path: script_path, output: options[:output]).run
  end
rescue Live2D::Error, JSON::ParserError, SystemCallError => error
  warn "Valkyrie Studio performance: #{error.message}"
  exit 1
end
