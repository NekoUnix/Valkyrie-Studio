#!/usr/bin/env ruby
# frozen_string_literal: true
require_relative '../lib/live2d_studio'
if ARGV.first == '--help'
  puts 'Usage: ruby bin/agent --check | --connect | JSON_COMMAND'
  puts 'Run --connect after opening a model to select agent control and verify readiness.'
  puts 'See docs/CONNECT_AGENT.md for Python and other AI agent integrations.'
  exit
end
check = ARGV.first == '--check'
connect = ARGV.first == '--connect'
token = ENV['L2D_API_TOKEN'].to_s
port = Integer(ENV.fetch('L2D_API_PORT', '4141'))
token_path = File.join(Live2D::ROOT, 'tmp', port == 4141 ? 'api-token' : "api-token-#{port}")
token = File.read(token_path).strip if token.empty?
command = JSON.parse(check || connect ? '{"op":"status"}' : ARGV.fetch(0, '{"op":"status"}'))
socket = TCPSocket.new('127.0.0.1', port)
send_command = lambda do |request|
  socket.write(JSON.generate(request.merge('token' => token, 'id' => SecureRandom.hex(4))) + "\n")
  raise Live2D::Error, 'Studio response timed out' unless IO.select([socket], nil, nil, 10)
  response = JSON.parse(socket.gets || raise(Live2D::Error, 'Studio closed the connection'))
  raise Live2D::Error, response.fetch('error', 'Agent request failed') unless response['ok']
  response
end
send_command.call('op' => 'mode', 'mode' => 'agent') if connect
response = send_command.call(command)
if check || connect
  result = response.fetch('result')
  agent = result.fetch('agent', {})
  puts "Valkyrie Studio: #{result['model']} | mode: #{result['mode']} | agent: #{agent['ready'] ? 'READY' : 'NOT READY'} | commands: #{agent.fetch('commands', 0)}"
  puts 'Load a model and run ruby bin/agent --connect to enable agent control.' unless agent['ready']
else
  puts JSON.generate(response)
end
socket.close
